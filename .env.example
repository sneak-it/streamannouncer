# Discord Configuration
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="YOUR_GUILD_ID"
DISCORD_ROLE_ID="YOUR_ROLE_ID"
DISCORD_ADMIN_ROLE_ID="YOUR_ADMIN_ROLE_ID"
DISCORD_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_ANNOUNCEMENT_MESSAGE="Hey {mention}, {user} is now live on Twitch! {url}"

# Twitch Configuration
TWITCH_CLIENT_ID="YOUR_TWITCH_CLIENT_ID"
TWITCH_CLIENT_SECRET="YOUR_TWITCH_CLIENT_SECRET"

# Logging
LOG_LEVEL=info                   # Log level: trace, debug, info, warn, error (default: info)

# Embed customization
# EMBED_COLOR=#9146FF            # Hex color for embed border (default: Twitch purple)

# Timezone
# TZ=America/New_York            # Default: America/New_York

# Database backup
# BACKUP_ENABLED=true              # Enable periodic database backups (default: true)
# BACKUP_INTERVAL_MINUTES=60       # Interval between backups in minutes (default: 60)
# BACKUP_MAX_KEEP=5                # Maximum number of backups to keep (default: 5)